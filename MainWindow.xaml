<Window x:Class="GoodbyeDPI_GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GoodbyeDPI V2 GUI - by Toprak" 
        Height="920" 
        Width="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    
    <Border CornerRadius="24" Background="#0D0D1A">
        <Border.Effect>
            <DropShadowEffect Color="#7B2CBF" BlurRadius="30" ShadowDepth="0" Opacity="0.4"/>
        </Border.Effect>
        
        <Grid>
            <!-- Background Decorations -->
            <Ellipse Width="300" Height="300" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-100,-100,0" Opacity="0.1">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#7B2CBF" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            
            <Ellipse Width="200" Height="200" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="-60,0,0,-60" Opacity="0.1">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#00F5D4" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Grid Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- Header -->
                    <RowDefinition Height="Auto"/>   <!-- Status -->
                    <RowDefinition Height="*"/>      <!-- Scrollable content -->
                    <RowDefinition Height="Auto"/>   <!-- Footer -->
                </Grid.RowDefinitions>

                <!-- Title Bar + Sticky Signature -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="50" Height="50" CornerRadius="14" Margin="0,0,12,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#E30A17" Offset="0"/>
                                    <GradientStop Color="#7B2CBF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="🇹🇷" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="GoodbyeDPI" FontSize="24" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="V2 GUI • Turkey Edition" FontSize="12" Foreground="#00F5D4" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Sticky signature always visible -->
                        <Border Background="#1E1E2E" Padding="10,6" CornerRadius="8" BorderBrush="#00F5D4" BorderThickness="1" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="♥" Foreground="#E30A17" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Toprak" Foreground="#00F5D4" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="|" Foreground="#5A5A6E" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Button x:Name="GitHubBtnTop" Click="GitHubBtn_Click"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="GitHub" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock Text=" @toprak1224" Foreground="#00F5D4" FontSize="10"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Button x:Name="MinimizeBtn" Content="─" Width="35" Height="35" 
                                Background="Transparent" Foreground="#8A8A9E"
                                BorderThickness="0" FontSize="14" Click="MinimizeBtn_Click" Cursor="Hand"/>
                        <Button x:Name="CloseBtn" Content="✕" Width="35" Height="35" 
                                Background="Transparent" Foreground="#8A8A9E"
                                BorderThickness="0" FontSize="12" Click="CloseBtn_Click" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <!-- Status Card -->
                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Grid Width="55" Height="55" Margin="0,0,15,0">
                            <Ellipse x:Name="StatusGlow" Fill="#8A8A9E" Opacity="0.3">
                                <Ellipse.Effect>
                                    <BlurEffect Radius="12"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Width="35" Height="35" Fill="#8A8A9E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Durum" FontSize="11" Foreground="#8A8A9E"/>
                            <TextBlock x:Name="StatusText" Text="Hazır" FontSize="20" FontWeight="Bold" Foreground="White"/>
                            <TextBlock x:Name="StatusDescription" Text="Bir mod seçip başlatın" FontSize="11" Foreground="#8A8A9E"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Scrollable Content -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <!-- Hide scrollbars but keep scrolling -->
                        <Style TargetType="ScrollBar">
                            <Setter Property="Opacity" Value="0"/>
                            <Setter Property="Width" Value="0"/>
                        </Style>
                    </ScrollViewer.Resources>
                    <StackPanel>
                        <!-- GEÇİCİ MODLAR -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="⏱️" FontSize="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="GEÇİCİ MOD" FontSize="14" FontWeight="Bold" Foreground="#00F5D4"/>
                                    <TextBlock Text=" (turkey_dnsredir*.cmd)" FontSize="11" Foreground="#8A8A9E" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Program kapatılınca DPI de kapanır" FontSize="10" Foreground="#6A6A7E" Margin="0,0,0,10"/>
                                
                                <ComboBox x:Name="TempModeComboBox" Padding="10,8" FontSize="12"
                                          Background="White" Foreground="Black" BorderBrush="#00F5D4" BorderThickness="2"
                                          SelectionChanged="TempModeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="turkey_dnsredir" Foreground="Black" IsSelected="True"/>
                                    <ComboBoxItem Content="turkey_dnsredir_alternative_superonline" Foreground="Black"/>
                                    <ComboBoxItem Content="turkey_dnsredir_alternative2_superonline" Foreground="Black"/>
                                    <ComboBoxItem Content="turkey_dnsredir_alternative3_superonline" Foreground="Black"/>
                                    <ComboBoxItem Content="turkey_dnsredir_alternative4_superonline" Foreground="Black"/>
                                    <ComboBoxItem Content="turkey_dnsredir_alternative5_superonline (ÖNERİLEN)" Foreground="Black"/>
                                    <ComboBoxItem Content="turkey_dnsredir_alternative6_superonline" Foreground="Black"/>
                                </ComboBox>
                                
                                <Border Background="#1A2A1A" CornerRadius="8" Padding="10" Margin="0,10,0,10">
                                    <TextBlock x:Name="TempModeDescription" 
                                              Text="Mod 5 + TTL 5 + Yandex DNS — Çoğu ISS için çalışır" 
                                              FontSize="10" Foreground="#90EE90" TextWrapping="Wrap"/>
                                </Border>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Button x:Name="TempStartButton" Grid.Column="0" Content="▶ BAŞLAT" 
                                            Style="{StaticResource ModernButton}" Click="TempStartButton_Click" Padding="20,12"/>
                                    <Button x:Name="TempStopButton" Grid.Column="2" Content="■ DURDUR" 
                                            Style="{StaticResource SecondaryButton}" IsEnabled="False" 
                                            Click="TempStopButton_Click" Padding="20,12"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- KALICI MODLAR -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="💾" FontSize="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="KALICI MOD" FontSize="14" FontWeight="Bold" Foreground="#FF8C00"/>
                                    <TextBlock Text=" (service_install*.cmd)" FontSize="11" Foreground="#8A8A9E" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Windows servisi olarak kurulur, bilgisayar açılınca otomatik başlar" FontSize="10" Foreground="#6A6A7E" Margin="0,0,0,10"/>
                                
                                <ComboBox x:Name="ServiceModeComboBox" Padding="10,8" FontSize="12"
                                          Background="White" Foreground="Black" BorderBrush="#FF8C00" BorderThickness="2"
                                          SelectionChanged="ServiceModeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="service_install_dnsredir_turkey" Foreground="Black" IsSelected="True"/>
                                    <ComboBoxItem Content="service_install_dnsredir_turkey_alternative_superonline" Foreground="Black"/>
                                    <ComboBoxItem Content="service_install_dnsredir_turkey_alternative2_superonline" Foreground="Black"/>
                                    <ComboBoxItem Content="service_install_dnsredir_turkey_alternative3_superonline" Foreground="Black"/>
                                    <ComboBoxItem Content="service_install_dnsredir_turkey_alternative4_superonline" Foreground="Black"/>
                                    <ComboBoxItem Content="service_install_dnsredir_turkey_alternative5_superonline (ÖNERİLEN)" Foreground="Black"/>
                                    <ComboBoxItem Content="service_install_dnsredir_turkey_alternative6_superonline" Foreground="Black"/>
                                </ComboBox>
                                
                                <Border Background="#2A2A1A" CornerRadius="8" Padding="10" Margin="0,10,0,10">
                                    <TextBlock x:Name="ServiceModeDescription" 
                                              Text="Mod 5 + TTL 5 + Yandex DNS — Çoğu ISS için çalışır" 
                                              FontSize="10" Foreground="#FFD700" TextWrapping="Wrap"/>
                                </Border>
                                
                                <Button x:Name="ServiceInstallButton" Content="📦 SERVİS OLARAK KUR" 
                                        Click="ServiceInstallButton_Click" Cursor="Hand"
                                        Background="#4A3500" BorderThickness="0" Padding="15,12" Margin="0,0,0,10">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                                    CornerRadius="10" Padding="{TemplateBinding Padding}"
                                                    BorderBrush="#FF8C00" BorderThickness="2">
                                                <TextBlock Text="{TemplateBinding Content}" Foreground="White" 
                                                          FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#5A4500"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- SERVİS KALDIRMA -->
                        <Button x:Name="ServiceRemoveBtn" Click="ServiceRemoveBtn_Click" Cursor="Hand"
                                Background="#2A1A1A" BorderThickness="0" Padding="12,10" Margin="0,0,0,12">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="{TemplateBinding Background}"
                                            CornerRadius="10" Padding="{TemplateBinding Padding}"
                                            BorderBrush="#FF4444" BorderThickness="2">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="🗑️" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Servisi Kaldır (service_remove.cmd)" Foreground="White" 
                                                      FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#3A2A2A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Log Output -->
                        <Border Style="{StaticResource CardBorder}" Height="180">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="📝 Günlük" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                    <Button x:Name="ClearLogBtn" Content="Temizle" HorizontalAlignment="Right"
                                            Background="Transparent" Foreground="#8A8A9E" BorderThickness="0"
                                            FontSize="10" Cursor="Hand" Click="ClearLogBtn_Click"/>
                                </Grid>
                                
                                <Border Grid.Row="1" Background="#0A0A12" CornerRadius="8" Padding="8">
                                    <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                                        <ScrollViewer.Resources>
                                            <Style TargetType="ScrollBar">
                                                <Setter Property="Opacity" Value="0"/>
                                                <Setter Property="Width" Value="0"/>
                                            </Style>
                                        </ScrollViewer.Resources>
                                        <TextBlock x:Name="LogOutput" Text="" FontFamily="Consolas"
                                                  FontSize="10" Foreground="#00F5D4" TextWrapping="Wrap"/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer (sticky) -->
                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Made with " Foreground="#8A8A9E" FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Text="♥" Foreground="#E30A17" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text=" by " Foreground="#8A8A9E" FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Text="Toprak" Foreground="#00F5D4" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="GoodbyeDPI V2 GUI • Turkey Edition" FontSize="9" Foreground="#5A5A6E" Margin="0,2,0,0"/>
                    </StackPanel>
                    
                    <Button x:Name="GitHubBtn" Grid.Column="1" Click="GitHubBtn_Click"
                            Background="#252540" BorderThickness="0" Cursor="Hand" Padding="10,6">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⭐" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="@toprak1224" Foreground="#00F5D4" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#353560"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
